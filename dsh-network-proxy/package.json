{
  "name": "dsh-network-proxy",
  "version": "1.1.0",
  "description": "DSH 网络代理管理插件：在设置界面随时切换 跟随系统 / 手动代理 / 直连 三种网络出口模式，修改后立即生效。 / DSH network proxy plugin: switch between system / manual / direct proxy modes from the settings UI, applied live.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "network",
    "网络代理"
  ],
  "license": "MIT",
  "author": "七朔 <liuxiaopeng731@gmail.com>",
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxp731/agents-plugins.git",
    "directory": "dsh-network-proxy"
  },
  "bugs": {
    "url": "https://github.com/lxp731/agents-plugins/issues"
  },
  "homepage": "https://github.com/lxp731/agents-plugins/tree/main/dsh-network-proxy#readme",
  "dependencies": {
    "undici": "^7.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "category": "extension",
    "displayName": "网络代理",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
