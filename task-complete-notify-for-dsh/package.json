{
  "name": "task-complete-notify-for-dsh",
  "version": "0.1.0",
  "description": "DSH plugin: desktop notification + chime when a run finishes. Notifies on completion, error, and approval requests, with a configurable duration threshold. / DSH 桌面通知插件：运行完成/出错/等待审批时提醒，可配置时长阈值与提示音。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "desktop-notification",
    "notify",
    "chime",
    "agent",
    "通知",
    "桌面通知",
    "插件"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "dsh": {
    "category": "extension",
    "displayName": "运行完成通知",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
