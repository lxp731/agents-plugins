{
  "name": "dsh-service-control",
  "version": "0.1.2",
  "description": "DSH service control: A standalone CLI (dshctl) with shell completion. / DSH 服务启停控制，独立 CLI 与补全。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "bin": {
    "dshctl": "bin/dshctl.js"
  },
  "files": [
    "lib",
    "bin",
    "scripts",
    "completions",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "service",
    "control",
    "daemon",
    "restart"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
